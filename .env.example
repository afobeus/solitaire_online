# Локально используйте http://localhost:5173. В production — домен с https:// без завершающего /.
APP_ORIGIN=http://localhost:5173
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_PATH=./data/solitaire.sqlite
TRUST_PROXY=false
LOG_LEVEL=info

# Пределы для VPS 1 vCPU / 1 ГБ. Подтверждённой гарантии нагрузки эти числа не дают.
MAX_MATCHES=12
MAX_CONNECTIONS=120
MAX_ROOMS=40
MAX_PLAYERS=8
MAX_MESSAGE_BYTES=4096
MAX_BUFFERED_BYTES=262144
COMMANDS_PER_SECOND=20

# Игровые параметры, миллисекунды.
MOVE_MS=180
TICK_MS=250
DISCONNECT_MS=20000
COUNTDOWN_MS=3000
DUEL_MS=360000
PROTECTION_MS=5000
OUTSIDE_MS=10000
RECON_MS=8000
PEEK_MS=5000
MAP_SIZE=18
VISION_RADIUS=4
LOOT_COUNT=9
INVENTORY_SIZE=3
SESSION_DAYS=30
RESULT_RETENTION_MS=60000
# Строго возрастающее расписание; последний этап обязан быть final.
ZONE_STAGES=[{"afterMs":90000,"inset":2},{"afterMs":180000,"inset":4},{"afterMs":270000,"inset":5},{"afterMs":330000,"inset":7},{"afterMs":360000,"inset":8,"final":true}]
